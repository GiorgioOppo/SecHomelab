# python3 init.py copia questo file e riempie i segreti vuoti.
COMPOSE_PROJECT_NAME=misp
BASE_URL=https://localhost:8443
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
TZ=Europe/Rome

# Immagini della nuova architettura con Nginx separato.
# Per un deployment stabile, fissare tag verificati e compatibili tra loro.
CORE_RUNNING_TAG=latest
MODULES_RUNNING_TAG=latest

ADMIN_EMAIL=admin@localhost.test
ADMIN_ORG=MISP
MISP_EMAIL=admin@localhost.test
ADMIN_PASSWORD=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
GPG_PASSPHRASE=
ENCRYPTION_KEY=

# Relay SMTP esterno opzionale: completare per una consegna email affidabile.
SMARTHOST_ADDRESS=
SMARTHOST_PORT=587
SMARTHOST_USER=
SMARTHOST_PASSWORD=
SMARTHOST_ALIASES=

INNODB_BUFFER_POOL_SIZE=512M
PHP_MEMORY_LIMIT=2048M

# Opzionale: chiave personale per importare la blacklist AbuseIPDB.
ABUSEIPDB_API_KEY=

# GreyNoise: chiave per arricchimento IP o feed, secondo i permessi del piano.
GREYNOISE_API_KEY=

# Generata da splunk_setup.py per l'account MISP dedicato di sola lettura.
MISP_SPLUNK_API_KEY=

# Splunk Enterprise standalone; accessibile soltanto dal Mac.
SPLUNK_IMAGE=docker.io/splunk/splunk:10.4.3
SPLUNK_BIND_ADDRESS=127.0.0.1
SPLUNK_WEB_PORT=8000
SPLUNK_API_PORT=8089
# Syslog: use 0.0.0.0 to receive IPv4 LAN traffic; Web/API binding is separate.
SPLUNK_SYSLOG_BIND_ADDRESS=127.0.0.1
SPLUNK_SYSLOG_PORT=5514
SPLUNK_PASSWORD=
# Dopo aver letto e accettato https://www.splunk.com/en_us/legal/splunk-general-terms.html:
# SPLUNK_START_ARGS=--accept-license
# SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com
SPLUNK_START_ARGS=
SPLUNK_GENERAL_TERMS=
